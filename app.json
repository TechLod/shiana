{
  "expo": {
    "name": "Shiana",
    "slug": "shiana",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "shiana",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Shiana to access your camera",
        "NSMicrophoneUsageDescription": "Allow Shiana to access your microphone for video"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.bobbymich.shiana",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-video",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Shiana to access your camera",
          "microphonePermission": "Allow Shiana to access your microphone for video",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Shiana to access photos"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Shiana to use your location."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Shiana to save photos",
          "savePhotosPermission": "Allow Shiana to save videos to gallery",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "@react-native-community/datetimepicker",
      "react-native-vision-camera"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "640cec67-0288-45f2-a25c-ec60206c2559"
      }
    }
  }
}
